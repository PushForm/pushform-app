# Optional, public read-only catalog endpoint. Use HTTPS outside localhost.
# No credentials, API secrets or private-file URLs belong here.
# VITE_COMMONS_CATALOG_URL=https://catalog.example.com/commons/catalog.json

# Alternatively, use the reviewed database catalog with public credentials only.
# VITE_SUPABASE_URL=https://your-project.example.com
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Optional public file-service origin for attribution ZIP downloads.
# VITE_COMMONS_ASSETS_URL=https://files.example.com

# Public web editor destination for Open in PushForm (default app.pushform.io).
# VITE_PUSHFORM_EDITOR_URL=https://editor.example.com

# Optional web editor origin for model-specific Open in PushForm actions.
# VITE_PUSHFORM_EDITOR_URL=https://app.example.com
