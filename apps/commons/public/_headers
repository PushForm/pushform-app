/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https: blob:; connect-src 'self' https:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

# Built JS and CSS carry a content hash in their names, so a browser can keep them without rechecking.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
