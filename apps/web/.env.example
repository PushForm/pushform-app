# Public browser configuration. Never use a Supabase secret or service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy alternative: VITE_SUPABASE_ANON_KEY=
# Region the feature request Edge Function runs in; set it to the database's region (the hosted project is us-east-1).
# Without it, Supabase runs the function near each user and every database call crosses regions.
# VITE_FR_REGION=us-east-1

# Local Supabase stack (pnpm db:start): run `pnpm db:env` to generate apps/web/.env.localdb.local
# with the local URL and anon key, then `pnpm dev:local`. Local sign-in emails appear in the
# Inbucket/Mailpit inbox printed by `pnpm db:status`, nothing is sent.

# Optional public PostHog ingestion token; leave empty to disable product analytics.
# A submitted account preference and browser privacy signals still gate every request.
VITE_POSTHOG_TOKEN=

# Optional JSON with public pinned keys and HTTPS distribution endpoints. No private signing key belongs here.
# Fields: keys [{id, publicKey (base64 SEC1 P-256 point), notBefore, notAfter}], registryUrl, revocationsUrl, origins.
VITE_EXTENSION_DISTRIBUTION=
