{
  "name": "pushform",
  "private": true,
  "version": "0.0.1",
  "description": "PushForm: push/pull modeling on always-solid geometry, for desktop and web",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pushform/app-web dev",
    "build": "pnpm --filter @pushform/app-web build",
    "desktop": "pnpm --filter @pushform/app-desktop tauri dev",
    "desktop:local": "pnpm --filter @pushform/app-desktop tauri dev --config src-tauri/tauri.localdb.conf.json",
    "deploy:pages": "node scripts/deploy.mjs",
    "verify-deploy": "node scripts/verify-deploy.mjs",
    "dev:local": "pnpm --filter @pushform/app-web exec vite --mode localdb",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "license-check": "node scripts/license-check.mjs",
    "spdx-check": "node scripts/spdx-headers.mjs --check",
    "spec-check": "node scripts/spec-ids.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.151.3"
  },
  "type": "module"
}
