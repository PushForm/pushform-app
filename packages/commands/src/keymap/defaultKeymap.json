    { "key": "Shift+Space", "command": "tool.lasso" },
    { "key": "B", "command": "tool.paint" },
    { "key": "E", "command": "tool.eraser" },
    { "key": "L", "command": "tool.line" },
    { "key": "R", "command": "tool.rectangle" },
    { "key": "C", "command": "tool.circle" },
    { "key": "A", "command": "tool.arc2" },
    { "key": "M", "command": "tool.move" },
    { "key": "P", "command": "tool.pushpull" },
    { "key": "Q", "command": "tool.rotate" },
    { "key": "S", "command": "tool.scale" },
    { "key": "F", "command": "tool.offset" },
    { "key": "T", "command": "tool.tape" },
    { "key": "O", "command": "tool.orbit" },
    { "key": "H", "command": "tool.pan" },
    { "key": "Z", "command": "tool.zoom" },
