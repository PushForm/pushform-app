exports[`requester emails snapshots > Filed for each eligibility > filed auto 1`] = `
{
  "html": "<!doctype html>
<html><head><meta charset="utf-8"><title>[FRQ-123] Filed: Layout: nudge viewports with arrow keys</title></head>
<body style="font-family:system-ui,sans-serif;line-height:1.5;max-width:40em;margin:1em auto;padding:0 1em">
<p>Hello,</p>
<p>Your request was filed with PushForm as FRQ-123.</p>
<p><strong>Identifier:</strong> FRQ-123<br><strong>Title:</strong> Layout: nudge viewports with arrow keys<br><strong>Kind:</strong> Feature<br><strong>Filed by:</strong> ada@example.com</p>
<h2>What happens next</h2>
<p>The team will review your request in Linear and may ask questions by email.</p>
<h2>Kind</h2>
<p>Feature</p>
<h2>Problem</h2>
<p>I cannot nudge a Layout viewport with the keyboard.</p>
<h2>Current workaround</h2>
<p>Not provided</p>
<h2>Desired behavior</h2>
<p>Arrow keys move the selected viewport by 1 mm.</p>
<h2>Acceptance examples</h2>
<p>- When I select a viewport and press Right, then it moves 1 mm right.<br>- When nothing is selected and I press Right, then the page scrolls as before.</p>
<h2>Must not change</h2>
<p>Mouse dragging of viewports.</p>
<h2>Area</h2>
<p>Layout</p>
<h2>Importance</h2>
<p>Important: Precise placement is slow with the mouse.</p>
<p>This email is about request FRQ-123 only.</p>
<p>Questions for the team: reply to support@pushform.io.</p>
</body></html>
",
  "subject": "[FRQ-123] Filed: Layout: nudge viewports with arrow keys",
  "text": "Hello,

Your request was filed with PushForm as FRQ-123.

